# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# ── Catalog DB ────────────────────────────────────────────────────────────────
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
CATALOG_DB_NAME=CatalogDb
CATALOG_DB_PORT=5438

# ── Customer DB ───────────────────────────────────────────────────────────────
CUSTOMER_DB_USER=
CUSTOMER_DB_PASSWORD=
CUSTOMER_DB_NAME=CustomerDb
CUSTOMER_DB_PORT=5439

# ── Order DB ──────────────────────────────────────────────────────────────────
ORDER_DB_USER=
ORDER_DB_PASSWORD=
ORDER_DB_NAME=OrderDb
ORDER_DB_PORT=5440

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Admin console: http://localhost:8180  (user: KEYCLOAK_ADMIN_USER)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180

# Fill in after creating the realm and a service-account client in the Keycloak UI.
# Inside Docker the base URL uses the service name, not localhost.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=gamevault
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/gamevault
KEYCLOAK_AUDIENCE=account
# Keycloak admin client credentials are now stored in infra/dapr/secrets.json (Dapr secret store).
# Copy infra/dapr/secrets.json.example → infra/dapr/secrets.json and fill in the values.

# ── WebEdge ───────────────────────────────────────────────────────────────────
# Gateway listens on http://localhost:5000.
# The cluster addresses are injected at runtime via docker-compose environment.
# ClientId/ClientSecret identify WebEdge to Keycloak — never exposed to clients.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
# Seq web UI is available at http://localhost:5380 after running docker compose up.
# No configuration needed — the Serilog Seq sink is pre-configured in
# appsettings.Development.json (Console + Seq → localhost:5341).
