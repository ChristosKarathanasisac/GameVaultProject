# ── Catalog DB ────────────────────────────────────────────────────────────────
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=postgres
CATALOG_DB_NAME=CatalogDb
CATALOG_DB_PORT=5438

# ── Customer DB ───────────────────────────────────────────────────────────────
CUSTOMER_DB_USER=postgres
CUSTOMER_DB_PASSWORD=postgres
CUSTOMER_DB_NAME=CustomerDb
CUSTOMER_DB_PORT=5439

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Set these after configuring the realm and service-account client in Keycloak
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=gamevault
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/gamevault
KEYCLOAK_AUDIENCE=account
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
