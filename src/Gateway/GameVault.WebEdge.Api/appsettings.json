{
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "Keycloak": {
    "BaseUrl": "",
    "Realm": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/customers/{**catch-all}" },
        "AuthorizationPolicy": "Anonymous"
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5235/" }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5236/" }
        }
      }
    }
  }
}
